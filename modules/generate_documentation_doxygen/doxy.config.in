# © Joseph Cameron - All Rights Reserved
#
# Doxygen configuration template, configured by jfc_generate_documentation_doxygen
#
#---------------------------------------------------------------------------
# Substituted by cmake
#---------------------------------------------------------------------------
EXCLUDE                = @EXCLUDE_DIRECTORIES@
HTML_OUTPUT            = @CMAKE_BINARY_DIR@/@CURRENT_DIR_BASENAME@/
INPUT                  = @README_PATH@ @INCLUDE_DIRECTORIES@
PROJECT_LOGO           = @PROJECT_LOGO@
PROJECT_NAME           = @GIT_REPO_NAME@
PROJECT_NUMBER         = @GIT_COMMIT_HASH@
USE_MDFILE_AS_MAINPAGE = @README_PATH@

#---------------------------------------------------------------------------
# Settings that differ from doxygen's defaults
#---------------------------------------------------------------------------
CASE_SENSE_NAMES       = NO                 # forces generated files to have lowercase names on all platforms
GENERATE_LATEX         = NO                 # no latex documentation, just html
GENERATE_TREEVIEW      = NO                 # Dont generate a treeview
RECURSIVE              = YES                # Headers can be in nested directories, not just flat include directories
TOC_INCLUDE_HEADINGS   = 0                  # The README is the main page; its headings should not each become a navigation entry.
WARN_AS_ERROR          = FAIL_ON_WARNINGS   # promote warnings to errors
WARN_IF_UNDOCUMENTED   = NO                 # Undocumented declarations are not an error. 

