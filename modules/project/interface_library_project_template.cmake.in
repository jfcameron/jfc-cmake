    @PUBLIC_INCLUDE_DIRECTORIES_value@)

# INTERFACE targets may not carry CXX_STANDARD; the equivalent usage requirement is a compile feature.
target_compile_features(${PROJECT_NAME} INTERFACE cxx_std_@C++_STANDARD_value@)

